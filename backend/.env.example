# ─── Gemini LLM ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PLAN_MODEL=gemini-1.5-flash
GEMINI_SYNTH_MODEL=gemini-1.5-pro

# ─── Databricks Genie ────────────────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your_databricks_pat_token
GENIE_SPACE_ID=01f137f8ed74188983eabc78abf23274

# ─── App Settings ────────────────────────────────────────────────────────────
# Set to true to use built-in demo data (no Databricks needed)
DEMO_MODE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
