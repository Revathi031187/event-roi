# ─── Gemini LLM ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PLAN_MODEL=gemini-1.5-flash
GEMINI_SYNTH_MODEL=gemini-1.5-pro

# ─── Databricks Genie ────────────────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your_databricks_pat_token
GENIE_SPACE_ID=01f137f8ed74188983eabc78abf23274

# ─── App Settings ────────────────────────────────────────────────────────────
# Set to true to use built-in demo data (no Databricks needed)
DEMO_MODE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── Langfuse (LLM observability & evals) ────────────────────────────────────
# Project-scoped keys from your Langfuse project settings (Cloud US region).
# Use a separate project/key pair per environment (dev/staging/prod) — never
# share one admin key across environments. Leave blank to run with tracing
# disabled (the app fails open and behaves exactly as before).
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://us.cloud.langfuse.com
# One of: development, staging, production — tags every trace so environments
# never mix in dashboards or eval/CI gates.
LANGFUSE_ENVIRONMENT=development
# Fraction (0.0-1.0) of pipeline runs that get the sampled LLM-as-judge (Tier 2)
# evaluators. Tier 1 code evaluators always run at 1.0 regardless of this value.
LANGFUSE_JUDGE_SAMPLE_RATE=0.2
